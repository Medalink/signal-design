{
  "name": "signal-design",
  "version": "1.4.0",
  "description": "Signal: a flat, square, mono design library for Tailwind CSS v4. Works in web apps, Tauri and anything that renders HTML.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Medalink/signal-design.git"
  },
  "keywords": [
    "design-system",
    "tailwindcss",
    "tailwind-v4",
    "css",
    "tauri",
    "ui"
  ],
  "style": "./dist/signal.css",
  "exports": {
    ".": {
      "types": "./src/js/index.d.ts",
      "style": "./src/signal.css",
      "import": "./src/js/index.js",
      "default": "./src/js/index.js"
    },
    "./css": "./src/signal.css",
    "./css/core": "./src/core.css",
    "./css/fonts/*": "./src/font-*.css",
    "./dist/signal.css": "./dist/signal.css",
    "./dist/signal-core.css": "./dist/signal-core.css",
    "./dist/font-*.css": "./dist/font-*.css",
    "./dist/signal.js": "./dist/signal.js",
    "./js": {
      "types": "./src/js/index.d.ts",
      "default": "./src/js/index.js"
    },
    "./js/*": "./src/js/*.js",
    "./fonts/*": "./src/fonts/*",
    "./charts": {
      "types": "./src/js/charts/index.d.ts",
      "default": "./src/js/charts/index.js"
    },
    "./ascii": {
      "types": "./src/js/ascii/index.d.ts",
      "default": "./src/js/ascii/index.js"
    },
    "./react": {
      "types": "./src/react/index.d.ts",
      "default": "./src/react/index.js"
    },
    "./ai/*": "./ai/*",
    "./vscode/*": "./vscode/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist",
    "bin",
    "ai",
    "vscode",
    "skills",
    ".claude-plugin",
    "AGENTS.md",
    "llms.txt",
    "llms-full.txt",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "peerDependencies": {
    "ascii-magic-art": "^1.0.2",
    "chart.js": "^4.5.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.3.0"
  },
  "peerDependenciesMeta": {
    "ascii-magic-art": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    },
    "chart.js": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "scripts": {
    "dev": "vite showcase",
    "build:css": "node scripts/build-css.mjs",
    "build:js": "node scripts/build-js.mjs",
    "build:showcase": "vite build showcase --outDir ../.showcase-dist --emptyOutDir",
    "build": "pnpm build:css && pnpm build:showcase",
    "prepack": "pnpm build:css",
    "check": "node scripts/check.mjs",
    "perf": "node scripts/perf.mjs",
    "a11y": "node scripts/a11y.mjs",
    "score": "node scripts/score.mjs",
    "build:ai": "node scripts/build-ai.mjs",
    "prepare": "node scripts/build-css.mjs && node scripts/build-js.mjs"
  },
  "devDependencies": {
    "@fontsource/source-code-pro": "5.3.1",
    "@tailwindcss/cli": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ascii-magic-art": "1.0.2",
    "axe-core": "4.10.3",
    "chart.js": "4.5.1",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  },
  "types": "./src/js/index.d.ts",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "packageManager": "pnpm@11.27.1",
  "bin": {
    "signal-design": "./bin/signal-design.mjs"
  }
}
